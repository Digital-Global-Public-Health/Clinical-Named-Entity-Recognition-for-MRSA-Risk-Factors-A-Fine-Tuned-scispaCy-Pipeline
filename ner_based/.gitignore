# Environment & secrets
.env
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Data files (large, PHI-sensitive)
data/interim/airms/notes/*.parquet
data/interim/airms/*.parquet
data/interim/airms/*.csv
!data/interim/airms/.gitkeep
!data/interim/airms/notes/.gitkeep

# Model checkpoints (large binaries)
models/checkpoints/
models/airms_ner_*/
models/mock_airms_ner/
!models/.gitkeep

# Annotations (may contain PHI)
annotations/*.jsonl
annotations/*.spacy
annotations/mock/
# PHI-bearing preannotation output
annotations/preannotations/
!annotations/.gitkeep

# Outputs (timestamped run dirs)
outputs/*/
!outputs/.gitkeep

# PHI-bearing single-patient note extraction output
data/interim/airms/extracted/
outputs/extracted/

# Conda / Python environments
*.egg-info/
dist/
build/
.eggs/
env/
venv/
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# macOS
.DS_Store

# IDE
.vscode/
.idea/
